{
  "$schema": "https://demotime.show/demo-time.schema.json",
  "title": "05 - Quiz",
  "description": "Short quiz with 4 questions",
  "version": 2,
  "demos": [
    {
      "id": "demo-mgunxs2s-w0rr",
      "title": "Quiztime",
      "steps": [
        {
          "action": "snippet",
          "contentPath": ".demo/.snippets/focus-on-content.json"
        },
        {
          "action": "openSlide",
          "path": ".demo/slides/quiz.md"
        }
