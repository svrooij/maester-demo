      "icons": {
        "start": "checklist",
        "end": ""
      },
      "description": "Quiz intro"
    },
    {
      "id": "demo-mgukdg9p-0i6z",
      "title": "Show session again",
      "steps": [
        {
          "action": "snippet",
          "contentPath": ".demo/.snippets/focus-on-content.json"
        },
        {
          "action": "closeAll"
        },
        {
          "action": "showEngageTimeSession"
        }
      ],
      "icons": {
        "start": "play-circle",
        "end": ""
      },
      "description": "In case you missed the QR the first time"
    },
    {
